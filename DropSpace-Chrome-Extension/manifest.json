{
  "manifest_version": 3,
  "name": "DropSpace",
  "version": "1.0.0",
  "description": "A calm, local-first workspace for everything you collect while browsing.",
  "icons": {
    "16": "dropspace-logo.png",
    "48": "dropspace-logo.png",
    "128": "dropspace-logo.png"
  },
  "permissions": ["storage", "sidePanel", "contextMenus", "activeTab"],
  "host_permissions": ["https://*.supabase.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open DropSpace",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "dropspace-logo.png",
      "48": "dropspace-logo.png",
      "128": "dropspace-logo.png"
    }
  },
  "side_panel": { "default_path": "index.html" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Open DropSpace" }
  }
}
